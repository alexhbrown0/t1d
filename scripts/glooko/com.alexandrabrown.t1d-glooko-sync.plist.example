<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexandrabrown.t1d-glooko-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/alexandrabrown/t1d/scripts/glooko/run-sync.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/alexandrabrown/t1d/scripts/glooko/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/alexandrabrown/t1d/scripts/glooko/logs/launchd.err.log</string>
</dict>
</plist>
